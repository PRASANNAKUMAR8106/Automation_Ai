# ==============================================================================
# AutoFlow AI - Environment Configuration Template
# Copy this file to .env before starting the application
# DO NOT COMMIT THE REAL .env FILE TO VERSION CONTROL
# ==============================================================================

# --- Application Profiles & Environment ---
SPRING_PROFILES_ACTIVE=dev
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
CLIENT_BASE_URL=http://localhost:3000

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autoflow_db
DB_USER=autoflow_user
DB_PASSWORD=autoflow_secure_pass_2026
DB_POOL_SIZE=20

# --- Redis Cache & Event Queues ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=autoflow_redis_pass_2026
REDIS_DATABASE=0
REDIS_TIMEOUT_MS=3000

# --- JWT & Security Configuration ---
# Generate with: openssl rand -base64 64
JWT_SECRET=4f8b9e6a3d1c7f5b2e8a0c4d6f8a2b4c6e8f0a2d4b6c8e0f2a4c6e8b0d2f4a6c8e0b2d4f6a8c0e2b4d6f8a0c2e4b6d8f0a2c4e6b8d0f2a4c6e8b0d2f4a6c8e
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=2592000

# --- S3 / MinIO Object Storage ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=autoflow_minio_admin
S3_SECRET_KEY=autoflow_minio_secret_2026
S3_BUCKET_MEDIA=autoflow-media
S3_BUCKET_INVOICES=autoflow-invoices
S3_BUCKET_PUBLIC=autoflow-public
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Razorpay Payment Gateway (Test Mode) ---
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourTestWebhookSecretHere
RAZORPAY_CURRENCY=INR

# --- Meta / Instagram Graph API ---
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=autoflow_meta_webhook_verify_token_2026
META_GRAPH_API_VERSION=v20.0
META_API_BASE_URL=https://graph.facebook.com/v20.0

# --- WhatsApp Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_waba_id
WHATSAPP_ACCESS_TOKEN=your_system_user_access_token

# --- Telegram Bot API ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_telegram_bot_username
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# --- AI & LLM Providers ---
OPENAI_API_KEY=sk-proj-YourOpenAiApiKeyHere
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google OAuth & Sheets API ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Email Notifications (SMTP / SES) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@autoflow.ai
SMTP_FROM_NAME="AutoFlow AI"

# --- Firebase Cloud Messaging (Push Notifications) ---
FIREBASE_CONFIG_PATH=classpath:firebase-service-account.json

# --- Influencer & Referral Defaults ---
DEFAULT_REFERRAL_ATTRIBUTION_DAYS=30
MINIMUM_PAYOUT_AMOUNT_INR=1000.00
COMMISSION_HOLD_PERIOD_DAYS=30
